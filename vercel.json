{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "api/draft.py",
      "use": "@vercel/python",
      "config": { "includeFiles": "{app.py,website.py,web/example.html}", "maxDuration": 30 }
    },
    { "src": "web/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/", "dest": "/web/index.html" },
    { "src": "/example", "dest": "/web/example.html" },
    { "src": "/(style[.]css|ui[.]js)", "dest": "/web/$1" },
    { "src": "/api/draft", "dest": "/api/draft.py" }
  ]
}

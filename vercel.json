{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "web",
  "functions": {
    "api/draft.py": {
      "includeFiles": "web/example.html",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/example", "destination": "/example.html" }
  ]
}
